 requiredHours Float
 description String
 sequence Int
 status String @default("Draft")
 apprenticeshipProgramId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([apprenticeshipProgramId])
 linkedApprenticeshipProgramId ApprenticeshipProgram @relation("WorkProcess_apprenticeshipProgramId", fields: [apprenticeshipProgramId], references: [id], onDelete: Restrict)
 inverseWorkHourEntry_workProcessId WorkHourEntry[] @relation("WorkHourEntry_workProcessId")
}

model WorkHourEntry {
